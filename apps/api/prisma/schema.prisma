// FinTrack core ledger schema (Increment 1).
// Conventions:
//  - All money columns are NUMERIC(20,4); never float.
//  - Snake_case table/column names in Postgres, camelCase in Prisma.
//  - Posted journals and lines are immutable (enforced by DB triggers in migration SQL).
//  - Audit log is hash-chained and append-only (DB trigger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Organisation ─────────────────────────────

model Company {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  baseCurrency String   @map("base_currency") @db.Char(3)
  taxPin       String?  @map("tax_pin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  facilities  Facility[]
  accounts    Account[]
  periods     FiscalPeriod[]
  journals    Journal[]
  accountMaps AccountMapping[]
  sequences   DocumentSequence[]

  @@map("companies")
}

model Facility {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  code       String   @unique
  name       String
  // External id used by CliniTrack/SupplyTrack/PeopleTrack events (facility_id in the envelope)
  externalId String   @unique @map("external_id")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  departments Department[]

  @@index([companyId])
  @@map("facilities")
}

model Department {
  id         String  @id @default(uuid()) @db.Uuid
  facilityId String  @map("facility_id") @db.Uuid
  code       String
  name       String
  active     Boolean @default(true)

  facility Facility @relation(fields: [facilityId], references: [id])

  @@unique([facilityId, code])
  @@map("departments")
}

// ───────────────────────────── Chart of accounts ─────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

/// Control accounts may only be posted by their owning sub-ledger, never by manual journals.
enum ControlAccountType {
  NONE
  AR_CONTROL
  AP_CONTROL
  PAYROLL_CONTROL
  STATUTORY_CONTROL
  DOCTOR_FUND_CONTROL
  BANK
  SUSPENSE
  FX_CLEARING
}

model Account {
  id            String             @id @default(uuid()) @db.Uuid
  companyId     String             @map("company_id") @db.Uuid
  code          String
  name          String
  type          AccountType
  normalBalance NormalBalance      @map("normal_balance")
  controlType   ControlAccountType @default(NONE) @map("control_type")
  parentId      String?            @map("parent_id") @db.Uuid
  isPostable    Boolean            @default(true) @map("is_postable")
  /// Null = any currency allowed.
  currency      String?            @db.Char(3)
  active        Boolean            @default(true)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company          @relation(fields: [companyId], references: [id])
  parent   Account?         @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]        @relation("AccountTree")
  lines    JournalLine[]
  mappings AccountMapping[]

  @@unique([companyId, code])
  @@map("accounts")
}

/// Posting rules: maps a logical key (e.g. AR_CONTROL:SHA, REVENUE:LAB) to a GL account per company.
model AccountMapping {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  mappingKey String   @map("mapping_key")
  accountId  String   @map("account_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  account Account @relation(fields: [accountId], references: [id])

  @@unique([companyId, mappingKey])
  @@map("account_mappings")
}

// ───────────────────────────── Periods ─────────────────────────────

enum PeriodStatus {
  OPEN
  SOFT_CLOSED
  LOCKED
}

model FiscalPeriod {
  id        String       @id @default(uuid()) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  code      String // e.g. 2026-11
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    PeriodStatus @default(OPEN)
  closedBy  String?      @map("closed_by") @db.Uuid
  closedAt  DateTime?    @map("closed_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id])
  journals Journal[]

  @@unique([companyId, code])
  @@index([companyId, startDate, endDate])
  @@map("fiscal_periods")
}

// ───────────────────────────── Journals ─────────────────────────────

enum JournalStatus {
  DRAFT
  VALIDATED
  APPROVED
  POSTED
  REVERSED
}

enum JournalSource {
  MANUAL
  CLINITRACK
  SUPPLYTRACK
  PEOPLETRACK
  FINTRACK
}

model Journal {
  id               String        @id @default(uuid()) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  facilityId       String?       @map("facility_id") @db.Uuid
  journalNo        String?       @map("journal_no")
  journalDate      DateTime      @map("journal_date") @db.Date
  periodId         String        @map("period_id") @db.Uuid
  description      String
  status           JournalStatus @default(DRAFT)
  source           JournalSource @default(MANUAL)
  sourceEntityType String?       @map("source_entity_type")
  sourceEntityId   String?       @map("source_entity_id")
  sourceVersion    Int?          @map("source_version")
  sourceEventId    String?       @map("source_event_id") @db.Uuid
  correlationId    String?       @map("correlation_id")
  /// Caller-provided or derived key; unique per company. Guarantees reruns never duplicate postings.
  idempotencyKey   String        @map("idempotency_key")
  reversalOfId     String?       @unique @map("reversal_of_id") @db.Uuid
  createdBy        String        @map("created_by") @db.Uuid
  validatedAt      DateTime?     @map("validated_at") @db.Timestamptz(6)
  approvedBy       String?       @map("approved_by") @db.Uuid
  approvedAt       DateTime?     @map("approved_at") @db.Timestamptz(6)
  postedBy         String?       @map("posted_by") @db.Uuid
  postedAt         DateTime?     @map("posted_at") @db.Timestamptz(6)
  reversedAt       DateTime?     @map("reversed_at") @db.Timestamptz(6)
  /// SHA-256 over the canonical posted content (header + lines); set at posting.
  contentHash      String?       @map("content_hash")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  company     Company       @relation(fields: [companyId], references: [id])
  period      FiscalPeriod  @relation(fields: [periodId], references: [id])
  lines       JournalLine[]
  reversalOf  Journal?      @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy  Journal?      @relation("Reversal")
  sourceEvent InboxEvent?   @relation(fields: [sourceEventId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@unique([companyId, journalNo])
  @@index([companyId, status, journalDate])
  @@index([source, sourceEntityType, sourceEntityId])
  @@map("journals")
}

model JournalLine {
  id           String  @id @default(uuid()) @db.Uuid
  journalId    String  @map("journal_id") @db.Uuid
  lineNo       Int     @map("line_no")
  accountId    String  @map("account_id") @db.Uuid
  facilityId   String? @map("facility_id") @db.Uuid
  departmentId String? @map("department_id") @db.Uuid
  currency     String  @db.Char(3)
  debit        Decimal @default(0) @db.Decimal(20, 4)
  credit       Decimal @default(0) @db.Decimal(20, 4)
  /// Rate to company base currency (1 when currency = base).
  fxRate       Decimal @default(1) @map("fx_rate") @db.Decimal(20, 10)
  baseDebit    Decimal @default(0) @map("base_debit") @db.Decimal(20, 4)
  baseCredit   Decimal @default(0) @map("base_credit") @db.Decimal(20, 4)
  description  String?
  /// Analytic dimensions (payer, supplier, doctor, vote head, source line ...). No PII.
  dimensions   Json    @default("{}")

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id])

  @@unique([journalId, lineNo])
  @@index([accountId])
  @@map("journal_lines")
}

model DocumentSequence {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  docType   String @map("doc_type")
  prefix    String
  nextValue Int    @default(1) @map("next_value")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, docType])
  @@map("document_sequences")
}

// ───────────────────────────── Integration inbox / outbox ─────────────────────────────

enum InboxStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED_DUPLICATE
  FAILED
  DEAD_LETTER
}

model InboxEvent {
  id                String      @id @default(uuid()) @db.Uuid
  sourceSystem      String      @map("source_system")
  eventId           String      @map("event_id")
  eventType         String      @map("event_type")
  sourceEntityType  String      @map("source_entity_type")
  sourceEntityId    String      @map("source_entity_id")
  sourceVersion     Int         @map("source_version")
  occurredAt        DateTime    @map("occurred_at") @db.Timestamptz(6)
  facilityExtId     String      @map("facility_ext_id")
  correlationId     String      @map("correlation_id")
  payload           Json
  payloadHash       String      @map("payload_hash")
  signatureVerified Boolean     @map("signature_verified")
  status            InboxStatus @default(RECEIVED)
  attempts          Int         @default(0)
  lastError         String?     @map("last_error")
  nextAttemptAt     DateTime?   @map("next_attempt_at") @db.Timestamptz(6)
  receivedAt        DateTime    @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt       DateTime?   @map("processed_at") @db.Timestamptz(6)

  journals Journal[]
  traces   PostingTrace[]

  @@unique([sourceSystem, eventId])
  @@index([status, nextAttemptAt])
  @@index([sourceSystem, sourceEntityType, sourceEntityId, sourceVersion])
  @@map("inbox_events")
}

/// Upstream -> downstream traceability: one inbox event may produce several financial artefacts.
model PostingTrace {
  id           String   @id @default(uuid()) @db.Uuid
  inboxEventId String   @map("inbox_event_id") @db.Uuid
  targetType   String   @map("target_type") // JOURNAL, AP_INVOICE, DEBTOR_INVOICE ...
  targetId     String   @map("target_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  inboxEvent InboxEvent @relation(fields: [inboxEventId], references: [id])

  @@unique([inboxEventId, targetType, targetId])
  @@index([targetType, targetId])
  @@map("posting_traces")
}

/// Processed source entity versions: blocks reposting the same source document version under a new event_id.
model SourceEntityVersion {
  sourceSystem     String   @map("source_system")
  sourceEntityType String   @map("source_entity_type")
  sourceEntityId   String   @map("source_entity_id")
  sourceVersion    Int      @map("source_version")
  inboxEventId     String   @map("inbox_event_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([sourceSystem, sourceEntityType, sourceEntityId, sourceVersion])
  @@map("source_entity_versions")
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTER
}

model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  payload       Json
  correlationId String?      @map("correlation_id")
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  availableAt   DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  publishedAt   DateTime?    @map("published_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}

// ───────────────────────────── Security & audit ─────────────────────────────

model User {
  id          String           @id @default(uuid()) @db.Uuid
  email       String           @unique
  displayName String           @map("display_name")
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RoleAssignment[]

  @@map("users")
}

/// Role granted to a user, optionally scoped to a company and/or facility (null = all).
model RoleAssignment {
  id         String  @id @default(uuid()) @db.Uuid
  userId     String  @map("user_id") @db.Uuid
  role       String
  companyId  String? @map("company_id") @db.Uuid
  facilityId String? @map("facility_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, role, companyId, facilityId])
  @@map("role_assignments")
}

/// Approval limits per role and document type (in company base currency).
model ApprovalLimit {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @map("company_id") @db.Uuid
  role      String
  docType   String  @map("doc_type")
  maxAmount Decimal @map("max_amount") @db.Decimal(20, 4)

  @@unique([companyId, role, docType])
  @@map("approval_limits")
}

/// Append-only, hash-chained audit log. seq is gap-free per insert order; hash = sha256(prev_hash || canonical row).
model AuditLog {
  seq        BigInt   @id @default(autoincrement())
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  companyId  String?  @map("company_id") @db.Uuid
  data       Json     @default("{}")
  prevHash   String   @map("prev_hash")
  hash       String   @unique

  @@index([entityType, entityId])
  @@map("audit_log")
}

// ═════════════════════════════ Increment 2: Accounts payable ═════════════════════════════

/// Lifecycle for sub-ledger documents (see packages/shared/src/statuses.ts).
enum DocStatus {
  DRAFT
  VALIDATED
  APPROVED
  POSTED
  PARTIALLY_SETTLED
  SETTLED
  REVERSED
}

enum ControlState {
  NONE
  DISPUTED
  ON_HOLD
}

enum SupplierStatus {
  ACTIVE
  BLOCKED
}

model Supplier {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  sourceSystem     String         @default("SUPPLYTRACK") @map("source_system")
  sourceSupplierId String         @map("source_supplier_id")
  code             String
  name             String
  taxPin           String?        @map("tax_pin")
  currency         String         @db.Char(3)
  paymentTermsDays Int            @default(30) @map("payment_terms_days")
  /// Withholding rate applied at payment (e.g. 0.05). 0 = none. (A-AP-03)
  withholdingRate  Decimal        @default(0) @map("withholding_rate") @db.Decimal(7, 6)
  /// Opaque reference to bank/M-PESA details held in the payments vault; never raw account numbers.
  payeeRef         String?        @map("payee_ref")
  status           SupplierStatus @default(ACTIVE)
  sourceVersion    Int            @default(1) @map("source_version")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  purchaseOrders PurchaseOrder[]
  invoices       ApInvoice[]

  @@unique([companyId, sourceSystem, sourceSupplierId])
  @@unique([companyId, code])
  @@map("suppliers")
}

model PurchaseOrder {
  id            String   @id @default(uuid()) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  facilityId    String   @map("facility_id") @db.Uuid
  supplierId    String   @map("supplier_id") @db.Uuid
  poNumber      String   @map("po_number")
  sourceId      String   @map("source_id")
  currency      String   @db.Char(3)
  orderDate     DateTime @map("order_date") @db.Date
  status        String   @default("APPROVED") // APPROVED | CLOSED | CANCELLED (owned by SupplyTrack)
  sourceVersion Int      @map("source_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]
  invoices ApInvoice[]

  @@unique([companyId, sourceId])
  @@unique([companyId, poNumber])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id          String  @id @default(uuid()) @db.Uuid
  poId        String  @map("po_id") @db.Uuid
  lineRef     String  @map("line_ref")
  itemRef     String? @map("item_ref")
  description String
  qtyOrdered  Decimal @map("qty_ordered") @db.Decimal(20, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(20, 4)
  taxRate     Decimal @default(0) @map("tax_rate") @db.Decimal(7, 6)
  /// Running totals maintained under row lock.
  qtyReceived Decimal @default(0) @map("qty_received") @db.Decimal(20, 4)
  qtyInvoiced Decimal @default(0) @map("qty_invoiced") @db.Decimal(20, 4)
  expenseKey  String? @map("expense_key") // account mapping key, e.g. AP_EXPENSE:MEDICAL_SUPPLIES

  po           PurchaseOrder      @relation(fields: [poId], references: [id])
  receiptLines GoodsReceiptLine[]
  invoiceLines ApInvoiceLine[]

  @@unique([poId, lineRef])
  @@map("purchase_order_lines")
}

enum ReceiptKind {
  GOODS
  SERVICE
}

model GoodsReceipt {
  id           String      @id @default(uuid()) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  poId         String      @map("po_id") @db.Uuid
  grnNumber    String      @map("grn_number")
  sourceId     String      @map("source_id")
  kind         ReceiptKind @default(GOODS)
  receivedDate DateTime    @map("received_date") @db.Date
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  po    PurchaseOrder      @relation(fields: [poId], references: [id])
  lines GoodsReceiptLine[]

  @@unique([companyId, sourceId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id          String  @id @default(uuid()) @db.Uuid
  receiptId   String  @map("receipt_id") @db.Uuid
  poLineId    String  @map("po_line_id") @db.Uuid
  qtyAccepted Decimal @map("qty_accepted") @db.Decimal(20, 4)

  receipt GoodsReceipt      @relation(fields: [receiptId], references: [id])
  poLine  PurchaseOrderLine @relation(fields: [poLineId], references: [id])

  @@map("goods_receipt_lines")
}

/// Matching tolerances per company (A-AP-01). Percentages as fractions (0.02 = 2%).
model ApTolerance {
  companyId       String   @id @map("company_id") @db.Uuid
  qtyPct          Decimal  @default(0) @map("qty_pct") @db.Decimal(7, 6)
  pricePct        Decimal  @default(0.02) @map("price_pct") @db.Decimal(7, 6)
  priceAbs        Decimal  @default(500) @map("price_abs") @db.Decimal(20, 4)
  taxAbs          Decimal  @default(1) @map("tax_abs") @db.Decimal(20, 4)
  /// Post matched invoices automatically (upstream approval already happened).
  autoPostMatched Boolean  @default(true) @map("auto_post_matched")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ap_tolerances")
}

enum ApDocKind {
  INVOICE
  CREDIT_NOTE
}

enum MatchType {
  TWO_WAY
  THREE_WAY
  NON_PO
}

enum MatchStatus {
  PENDING
  MATCHED
  EXCEPTION
  OVERRIDDEN
}

model ApInvoice {
  id                String       @id @default(uuid()) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  facilityId        String       @map("facility_id") @db.Uuid
  supplierId        String       @map("supplier_id") @db.Uuid
  poId              String?      @map("po_id") @db.Uuid
  kind              ApDocKind    @default(INVOICE)
  invoiceNumber     String       @map("invoice_number")
  /// Upper-cased, punctuation/whitespace stripped, leading zeros removed. Hard duplicate key.
  normalizedNumber  String       @map("normalized_number")
  /// sha256(supplier|invoice date|gross total|currency): soft-duplicate detector.
  fingerprint       String
  invoiceDate       DateTime     @map("invoice_date") @db.Date
  dueDate           DateTime     @map("due_date") @db.Date
  currency          String       @db.Char(3)
  subtotal          Decimal      @db.Decimal(20, 4)
  taxAmount         Decimal      @map("tax_amount") @db.Decimal(20, 4)
  total             Decimal      @db.Decimal(20, 4)
  /// Withholding expected at payment (supplier rate x subtotal). Recorded separately from tax.
  withholdingAmount Decimal      @default(0) @map("withholding_amount") @db.Decimal(20, 4)
  retentionAmount   Decimal      @default(0) @map("retention_amount") @db.Decimal(20, 4)
  amountSettled     Decimal      @default(0) @map("amount_settled") @db.Decimal(20, 4)
  status            DocStatus    @default(DRAFT)
  controlState      ControlState @default(NONE) @map("control_state")
  matchType         MatchType    @map("match_type")
  matchStatus       MatchStatus  @default(PENDING) @map("match_status")
  creditForId       String?      @map("credit_for_id") @db.Uuid
  journalId         String?      @unique @map("journal_id") @db.Uuid
  sourceSystem      String       @default("SUPPLYTRACK") @map("source_system")
  sourceEntityId    String       @map("source_entity_id")
  sourceVersion     Int          @map("source_version")
  approvedBy        String?      @map("approved_by") @db.Uuid
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(6)
  postedAt          DateTime?    @map("posted_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier    Supplier         @relation(fields: [supplierId], references: [id])
  po          PurchaseOrder?   @relation(fields: [poId], references: [id])
  creditFor   ApInvoice?       @relation("CreditNote", fields: [creditForId], references: [id])
  creditNotes ApInvoice[]      @relation("CreditNote")
  lines       ApInvoiceLine[]
  exceptions  MatchException[]
  allocations ApAllocation[]   @relation("AllocTarget")
  runItems    PaymentRunItem[]

  @@unique([companyId, supplierId, normalizedNumber, kind])
  @@unique([companyId, sourceSystem, sourceEntityId])
  @@index([companyId, supplierId, fingerprint])
  @@index([companyId, status, dueDate])
  @@map("ap_invoices")
}

model ApInvoiceLine {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  lineNo      Int     @map("line_no")
  poLineId    String? @map("po_line_id") @db.Uuid
  description String
  qty         Decimal @db.Decimal(20, 4)
  unitPrice   Decimal @map("unit_price") @db.Decimal(20, 4)
  netAmount   Decimal @map("net_amount") @db.Decimal(20, 4)
  taxAmount   Decimal @map("tax_amount") @db.Decimal(20, 4)
  expenseKey  String? @map("expense_key")

  invoice ApInvoice          @relation(fields: [invoiceId], references: [id])
  poLine  PurchaseOrderLine? @relation(fields: [poLineId], references: [id])

  @@unique([invoiceId, lineNo])
  @@map("ap_invoice_lines")
}

enum ExceptionType {
  QTY
  PRICE
  TAX
  TOTAL
  CURRENCY
  NO_RECEIPT
  NO_PO_LINE
  NON_PO_APPROVAL
  DUPLICATE_SUSPECT
  SUPPLIER_BLOCKED
}

enum ExceptionStatus {
  OPEN
  OVERRIDDEN
  RESOLVED
}

model MatchException {
  id         String          @id @default(uuid()) @db.Uuid
  invoiceId  String          @map("invoice_id") @db.Uuid
  lineNo     Int?            @map("line_no")
  type       ExceptionType
  message    String
  expected   String?
  actual     String?
  status     ExceptionStatus @default(OPEN)
  resolvedBy String?         @map("resolved_by") @db.Uuid
  resolvedAt DateTime?       @map("resolved_at") @db.Timestamptz(6)
  note       String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  invoice ApInvoice @relation(fields: [invoiceId], references: [id])

  @@index([status, type])
  @@map("ap_match_exceptions")
}

enum PaymentRunStatus {
  DRAFT
  APPROVED
  EXECUTING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  MPESA
  CHEQUE
}

model PaymentRun {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  runNo          String           @map("run_no")
  paymentDate    DateTime         @map("payment_date") @db.Date
  currency       String           @db.Char(3)
  method         PaymentMethod    @default(BANK_TRANSFER)
  bankMappingKey String           @default("BANK:DEFAULT") @map("bank_mapping_key")
  status         PaymentRunStatus @default(DRAFT)
  createdBy      String           @map("created_by") @db.Uuid
  approvedBy     String?          @map("approved_by") @db.Uuid
  approvedAt     DateTime?        @map("approved_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  items PaymentRunItem[]

  @@unique([companyId, runNo])
  @@map("ap_payment_runs")
}

enum PaymentItemStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

model PaymentRunItem {
  id            String            @id @default(uuid()) @db.Uuid
  runId         String            @map("run_id") @db.Uuid
  invoiceId     String            @map("invoice_id") @db.Uuid
  /// Amount of the liability being settled (gross of withholding).
  amount        Decimal           @db.Decimal(20, 4)
  withholding   Decimal           @default(0) @db.Decimal(20, 4)
  /// Cash actually disbursed = amount - withholding.
  netPaid       Decimal           @map("net_paid") @db.Decimal(20, 4)
  status        PaymentItemStatus @default(PENDING)
  bankReference String?           @map("bank_reference")
  failureReason String?           @map("failure_reason")
  journalId     String?           @map("journal_id") @db.Uuid
  allocationId  String?           @unique @map("allocation_id") @db.Uuid
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  run     PaymentRun @relation(fields: [runId], references: [id])
  invoice ApInvoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, status])
  @@map("ap_payment_run_items")
}

enum AllocationSource {
  PAYMENT
  CREDIT_NOTE
}

/// Settlement of a payable: by a payment item or a credit note. Reversal sets reversedAt (never deleted).
model ApAllocation {
  id         String           @id @default(uuid()) @db.Uuid
  invoiceId  String           @map("invoice_id") @db.Uuid
  sourceType AllocationSource @map("source_type")
  sourceId   String           @map("source_id") @db.Uuid
  amount     Decimal          @db.Decimal(20, 4)
  journalId  String?          @map("journal_id") @db.Uuid
  createdBy  String           @map("created_by") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  reversedAt DateTime?        @map("reversed_at") @db.Timestamptz(6)

  invoice ApInvoice @relation("AllocTarget", fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("ap_allocations")
}
