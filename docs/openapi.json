    "/api/v1/integration/events": {
      "post": {
        "operationId": "IntegrationController_ingest",
        "parameters": [
          {
            "name": "x-fintrack-timestamp",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-fintrack-signature",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-FinTrack-Signature",
            "in": "header",
            "description": "v1=hex(HMAC-SHA256(secret, `${timestamp}.${rawBody}`))",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-FinTrack-Timestamp",
            "in": "header",
            "description": "Unix seconds",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "IntegrationEventEnvelope (see packages/shared/src/events.ts)"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "summary": "Ingest a signed integration event (idempotent per source_system + event_id)",
        "tags": [
          "integration"
        ]
      }
    },
