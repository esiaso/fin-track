  "info": {
    "title": "FinTrack API",
    "description": "Financial system of record for multi-facility hospitals (SynergyOne Track family).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "1100"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "ASSET",
              "LIABILITY",
              "EQUITY",
              "REVENUE",
              "EXPENSE"
            ]
          },
          "controlType": {
            "type": "string",
            "enum": [
              "NONE",
              "AR_CONTROL",
              "AP_CONTROL",
              "PAYROLL_CONTROL",
              "STATUTORY_CONTROL",
              "DOCTOR_FUND_CONTROL",
              "BANK",
              "SUSPENSE",
              "FX_CLEARING"
            ]
          },
          "parentId": {
            "type": "string",
            "format": "uuid"
          },
          "isPostable": {
            "type": "boolean"
          },
          "currency": {
            "type": "string",
            "example": "KES"
          }
        },
        "required": [
          "companyId",
          "code",
          "name",
          "type"
        ]
      },
      "CreatePeriodDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "2026-12"
          },
          "startDate": {
            "type": "string",
            "example": "2026-12-01"
          },
          "endDate": {
            "type": "string",
            "example": "2026-12-31"
          }
        },
        "required": [
          "companyId",
          "code",
          "startDate",
          "endDate"
        ]
      },
      "PeriodTransitionDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "description": "Required when reopening"
          }
        }
      },
      "JournalLineInput": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "type": "string",
            "example": "KES"
          },
          "debit": {
            "type": "string",
            "example": "1000.00",
            "description": "Decimal string, max 4dp"
          },
          "credit": {
            "type": "string",
            "example": "0"
          },
          "fxRate": {
            "type": "string",
            "example": "1",
            "description": "Rate to company base currency; required when currency != base"
          },
          "facilityId": {
            "type": "string",
            "format": "uuid"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string"
          },
          "dimensions": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "accountId",
          "currency",
          "debit",
          "credit"
        ]
      },
      "CreateJournalDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "facilityId": {
            "type": "string",
            "format": "uuid"
          },
          "journalDate": {
            "type": "string",
            "example": "2026-11-22"
          },
          "description": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JournalLineInput"
            }
          }
        },
        "required": [
          "companyId",
          "journalDate",
          "description",
          "lines"
        ]
      },
      "ReverseJournalDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "reversalDate": {
            "type": "string",
            "description": "Reversal date; defaults to original date if its period is open, else today"
          }
        },
        "required": [
          "reason"
        ]
      },
      "ControlDto": {
        "type": "object",
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "NONE",
              "DISPUTED",
              "ON_HOLD"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "state",
          "reason"
        ]
      },
      "NoteDto": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string"
          }
        },
        "required": [
          "note"
        ]
      },
      "RunItemDto": {
        "type": "object",
        "properties": {
          "invoiceId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "string",
            "example": "1000.00"
          }
        },
        "required": [
          "invoiceId",
          "amount"
        ]
      },
      "CreateRunDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "format": "uuid"
          },
          "paymentDate": {
            "type": "string",
            "example": "2026-11-30"
          },
          "currency": {
            "type": "string",
            "example": "KES"
          },
          "method": {
            "type": "string",
            "enum": [
              "BANK_TRANSFER",
              "MPESA",
              "CHEQUE"
            ]
          },
          "bankMappingKey": {
            "type": "string",
            "example": "BANK:DEFAULT"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunItemDto"
            }
          }
        },
        "required": [
          "companyId",
          "paymentDate",
          "currency",
          "items"
        ]
      },
      "ItemResultDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PAID",
              "FAILED"
            ],
            "description": "FAILED on a PAID item records a bank return and reverses the payment"
          },
          "bankReference": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "valueDate": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
