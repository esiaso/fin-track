{
  "name": "fintrack",
  "private": true,
  "description": "FinTrack - financial system of record for multi-facility hospitals (SynergyOne Track family)",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @fintrack/api prisma:migrate",
    "db:seed": "pnpm --filter @fintrack/api prisma:seed",
    "dev:api": "pnpm --filter @fintrack/api dev",
    "dev:web": "pnpm --filter @fintrack/web dev"
  }
}
