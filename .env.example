# Copy to .env for local development
DATABASE_URL=postgresql://fintrack:fintrack@localhost:5432/fintrack?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-dev-only
JWT_ISSUER=fintrack
# Per-source HMAC secrets for inbound integration events
INTEGRATION_SECRET_CLINITRACK=dev-clinitrack-secret
INTEGRATION_SECRET_SUPPLYTRACK=dev-supplytrack-secret
INTEGRATION_SECRET_PEOPLETRACK=dev-peopletrack-secret
# Max skew (seconds) accepted between X-FinTrack-Timestamp and server time
INTEGRATION_MAX_SKEW_SECONDS=300
INBOX_MAX_ATTEMPTS=5
# Key used to encrypt sensitive PII columns (32 bytes, base64)
PII_ENCRYPTION_KEY=
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
